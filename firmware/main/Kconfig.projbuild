menu "Pocket Squatch"

    choice SQUATCH_BOARD
        prompt "Board"
        default SQUATCH_BOARD_LCD_4B
        help
            Which Waveshare board this build is for. The game draws the same 480x480
            picture on both; the AMOLED shows it scaled to fit its narrower screen.

        config SQUATCH_BOARD_LCD_4B
            bool "ESP32-S3-Touch-LCD-4B (4 inch, 480x480)"

        config SQUATCH_BOARD_AMOLED_18
            bool "ESP32-S3-Touch-AMOLED-1.8 (1.8 inch, 368x448, picture scaled)"
    endchoice

    config SQUATCH_WIFI_SSID
        string "Wi-Fi network (for setting the clock)"
        default ""
        help
            Used only to fetch the time at start-up, then Wi-Fi is switched off again.
            Leave empty to rely on the board's battery-backed clock alone.

    config SQUATCH_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config SQUATCH_TRAILS
        bool "Trail map: listen for nearby Wi-Fi networks"
        default y
        help
            Opening the trail map scans for nearby networks (without joining any) and
            turns each one into a place in the forest. Only a hash of each network's
            name is kept. Wi-Fi is on only for the two seconds of the scan.

    config SQUATCH_TZ
        string "Time zone (POSIX TZ string)"
        default "MST7MDT,M3.2.0,M11.1.0"
        help
            Decides when it's bedtime and when the sky gets dark. Examples:
            "EST5EDT,M3.2.0,M11.1.0" (US Eastern), "GMT0BST,M3.5.0/1,M10.5.0" (UK),
            "CET-1CEST,M3.5.0,M10.5.0/3" (Central Europe).

endmenu
